# PostgreSQL
POSTGRES_DB=abacachat_user
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# User service (publicação dos eventos)
SERVER_PORT=3000
APP_RABBITMQ_EXCHANGE=audit.exchange
APP_RABBITMQ_ROUTING_KEY=audit.user

# Audit database (Postgres exclusivo)
POSTGRES_AUDIT_DB=abacachat_audit
POSTGRES_AUDIT_PORT=5434

# Audit service (consumo dos eventos)
AUDIT_SERVER_PORT=8082
APP_RABBITMQ_QUEUE=audit.logs.queue
AUDIT_RABBITMQ_ROUTING_KEY="audit.#"
